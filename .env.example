# Copy to .env for local development (npm run dev / npm start / npm run seed).
# Every variable is optional: the values below are the defaults.

# development | test | production
NODE_ENV=development
# HTTP port
PORT=3000
# mongodb:// or mongodb+srv:// connection string (docker compose up -d mongo exposes 27017)
MONGODB_URI=mongodb://127.0.0.1:27017/wink-blog
# Bearer token required by every /api/v1/cms endpoint (at least 16 characters)
CMS_API_TOKEN=wink-cms-demo-token
# * or a comma-separated list of allowed browser origins
CORS_ORIGINS=*
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
